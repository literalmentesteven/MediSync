<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediSync.Views.LoginPage"
             Title="Login"
             Shell.NavBarIsVisible="False"
             Loaded="OnPageLoaded">

    <ContentPage.Background>
        <!-- Gradiente Animado (Olas Suaves) -->
        <LinearGradientBrush x:Name="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#FFFFFF" />
            <GradientStop Offset="0.5" Color="#E0F7FA" />
            <GradientStop Offset="1.0" Color="#FFFFFF" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="30">

            <!-- CAMBIO: Logo en lugar de texto -->
            <Image Source="medisync_logo.png"
                   HeightRequest="120"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <!-- Tarjeta Glassmorphism -->
            <Border StrokeThickness="1"
                    Stroke="{StaticResource MediLightGray}"
                    BackgroundColor="#CCFFFFFF"
                    Padding="30"
                    WidthRequest="380">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Radius="20" Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    
                    <!-- Input Usuario -->
                    <Border Stroke="{StaticResource MediCyan}" StrokeThickness="1" BackgroundColor="White" HeightRequest="50">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry x:Name="EntryUsuario" 
                               Placeholder="Usuario" 
                               Margin="10,0"/>
                    </Border>

                    <!-- Input Password -->
                    <Border Stroke="{StaticResource MediCyan}" StrokeThickness="1" BackgroundColor="White" HeightRequest="50">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry x:Name="EntryPassword" 
                               Placeholder="Contraseña" 
                               IsPassword="True" 
                               Margin="10,0"/>
                    </Border>

                    <Button Text="INICIAR SESIÓN"
                            Clicked="OnLoginClicked"
                            HeightRequest="50"
                            Margin="0,10,0,0"/>
                    
                    <ActivityIndicator x:Name="LoadingSpinner" 
                                       IsRunning="False" 
                                       Color="{StaticResource MediCyan}"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </Grid>
</ContentPage>