<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MediSync.Models"
             x:Class="MediSync.Views.DoctorsPage"
             Title="Doctores"
             BackgroundColor="{StaticResource MediLightGray}"
             Loaded="OnPageLoaded">

    <Grid RowDefinitions="Auto, *">
        
        <!-- HEADER -->
        <Label Text="DOCTORES" 
               FontSize="35" 
               FontAttributes="Bold" 
               TextColor="{StaticResource MediDarkGray}" 
               HorizontalOptions="Center" 
               Margin="0,20,0,10"/>

        <!-- CONTENEDOR PRINCIPAL -->
        <Grid Grid.Row="1" Padding="20,0">
            
            <!-- LISTA VERTICAL EN CUADRÍCULA (2 COLUMNAS) -->
            <!-- Esto permite usar la rueda del mouse nativa para bajar -->
            <CollectionView x:Name="DoctorsCollection"
                            VerticalScrollBarVisibility="Always"
                            SelectionMode="None">
                
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="20" HorizontalItemSpacing="20"/>
                </CollectionView.ItemsLayout>
                
                <!-- Margen inferior para que no se corte el último -->
                <CollectionView.Footer>
                    <BoxView HeightRequest="50" Color="Transparent"/>
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Usuario">
                        <!-- Tarjeta del Doctor -->
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="0" HeightRequest="480" StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.1" Radius="10" Offset="0,5"/>
                            </Border.Shadow>
                            
                            <Grid RowDefinitions="Auto, *, Auto">
                                <!-- Avatar -->
                                <Grid HeightRequest="140" BackgroundColor="{StaticResource MediCyan}">
                                    <Border HeightRequest="100" WidthRequest="100" StrokeShape="RoundRectangle 50" BackgroundColor="White" HorizontalOptions="Center" VerticalOptions="Center" StrokeThickness="0">
                                        <Label Text="Dr" TextColor="{StaticResource MediCyan}" FontSize="40" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Info -->
                                <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding NombreCompleto}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource MediDarkGray}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding Especialidad}" TextColor="{StaticResource MediCyan}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextTransform="Uppercase"/>
                                    <BoxView HeightRequest="2" Color="{StaticResource MediLightGray}" WidthRequest="50" HorizontalOptions="Center" Margin="0,8"/>
                                    <Label Text="{Binding Info}" TextColor="{StaticResource MediMediumGray}" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="3" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <!-- Botón -->
                                <Button Grid.Row="2" 
                                        Text="Ver Contacto" 
                                        BackgroundColor="{StaticResource MediDarkGray}" 
                                        TextColor="White" 
                                        Margin="40,0,40,25" 
                                        CornerRadius="20" 
                                        HeightRequest="45" 
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        Clicked="OnViewProfileClicked"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Loading / Empty -->
            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" Color="{StaticResource MediCyan}" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Label x:Name="EmptyLabel" Text="No hay doctores registrados." IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" TextColor="{StaticResource MediMediumGray}"/>
        </Grid>
    </Grid>
</ContentPage>